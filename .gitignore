# ---------------------------------------------------------------------------
# Copyrighted material — NEVER commit any of this.
# ---------------------------------------------------------------------------
# User-supplied Nintendo ROM dumps.
/rom/
*.z64
*.n64
*.v64
*.rom

# Anything extracted or derived from the ROM.
/assets/generated/
/build/

# Golden captures show the game's characters and stages: only their pixel
# hashes (tests/golden/hashes.tsv) are committed. tools/golden.sh keeps local
# PNG copies here for difference masks.
/tests/golden/local/
/tests/golden/*.png

# ROM-generated Rust tables are written to Cargo's OUT_DIR at build time
# (crates/ssb-tablegen). Never commit a generated copy.
/crates/ssb-game/src/motion/scripts.rs
/crates/ssb-rom/src/anim_table.rs
/crates/ssb-game/src/colanim_scripts.rs
/crates/ssb-game/src/computer/scripts.rs
/crates/ssb-game/src/spgame/stat_flags.rs

# ---------------------------------------------------------------------------
# Reference repositories (cloned locally for study, not vendored)
# ---------------------------------------------------------------------------
/refs/

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
target/
**/*.rs.bk

# ---------------------------------------------------------------------------
# PSP build artifacts
# ---------------------------------------------------------------------------
EBOOT.PBP
PARAM.SFO
*.prx

# ---------------------------------------------------------------------------
# N64 headless-emulator build artifacts
# ---------------------------------------------------------------------------
/tools/n64-headless/build/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
