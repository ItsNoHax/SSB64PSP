diff --git a/Core/MIPS/ICacheSim.h b/Core/MIPS/ICacheSim.h
new file mode 100644
index 0000000..0d9d693
--- /dev/null
+++ b/Core/MIPS/ICacheSim.h
@@ -0,0 +1,141 @@
+// SSB64PSP: a model of the Allegrex's 16 KB, 2-way, 64-byte-line
+// instruction cache, fed by the IR interpreter's executed blocks (`--ir`).
+// Env: PPSSPP_ICACHE=path (dump at shutdown), PPSSPP_ICACHE_START /
+// PPSSPP_ICACHE_STOP (emulated seconds, the counting window).
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <unistd.h>
+#include <unordered_map>
+#include "Common/CommonTypes.h"
+#include "Core/CoreTiming.h"
+#include "Core/MIPS/MIPS.h"
+
+struct ICacheSimState {
+	int enabled = -1;
+	u64 start = 0, stop = ~0ULL;
+	u32 tags[128][2];
+	u8 lru[128];  // way to evict next
+	u64 misses = 0, fetches = 0, blocks = 0;
+	u64 firstTick = 0, lastTick = 0;
+	std::unordered_map<u32, u64> missHist;   // line -> misses
+	std::unordered_map<u32, u64> fetchHist;  // line -> line fetches
+	// PPSSPP_ICACHE_PHASE=hex: a function's entry; misses between its entry
+	// and its return go to the phase counts (frames = its calls).
+	u32 phaseEntry = 0, phaseRet = 0;
+	bool inPhase = false;
+	u64 frames = 0, phaseMisses = 0, phaseFetches = 0;
+	std::unordered_map<u32, u64> phaseMissHist;
+	// PPSSPP_ICACHE_TRACE=path: the first PPSSPP_ICACHE_TRACE_N blocks of the
+	// window as (addr, words | phase << 16) words; dumps and exits when full.
+	FILE *trace = nullptr;
+	u64 traceLeft = 0;
+};
+
+inline ICacheSimState g_icache;
+
+inline bool ICacheSimEnabled() {
+	if (g_icache.enabled < 0) {
+		g_icache.enabled = getenv("PPSSPP_ICACHE") ? 1 : 0;
+		if (getenv("PPSSPP_ICACHE_START"))
+			g_icache.start = (u64)usToCycles((s64)(atof(getenv("PPSSPP_ICACHE_START")) * 1e6));
+		if (getenv("PPSSPP_ICACHE_STOP"))
+			g_icache.stop = (u64)usToCycles((s64)(atof(getenv("PPSSPP_ICACHE_STOP")) * 1e6));
+		if (getenv("PPSSPP_ICACHE_TRACE")) {
+			g_icache.trace = fopen(getenv("PPSSPP_ICACHE_TRACE"), "wb");
+			g_icache.traceLeft = getenv("PPSSPP_ICACHE_TRACE_N") ? strtoull(getenv("PPSSPP_ICACHE_TRACE_N"), nullptr, 10) : 1000000;
+		}
+		if (getenv("PPSSPP_ICACHE_PHASE"))
+			g_icache.phaseEntry = (u32)strtoul(getenv("PPSSPP_ICACHE_PHASE"), nullptr, 16);
+		for (int i = 0; i < 128; i++) {
+			g_icache.tags[i][0] = g_icache.tags[i][1] = 0xFFFFFFFF;
+			g_icache.lru[i] = 0;
+		}
+	}
+	return g_icache.enabled == 1;
+}
+
+inline void ICacheSimBlock(u32 addr, u32 words) {
+	ICacheSimState &c = g_icache;
+	u64 t = CoreTiming::GetTicks();
+	bool count = t >= c.start && t < c.stop;
+	if (c.phaseEntry) {
+		if (c.inPhase && addr == c.phaseRet) {
+			c.inPhase = false;
+		} else if (!c.inPhase && addr == c.phaseEntry) {
+			c.inPhase = true;
+			c.phaseRet = currentMIPS->r[31];
+			if (count)
+				c.frames++;
+		}
+	}
+	if (count) {
+		if (c.blocks == 0)
+			c.firstTick = t;
+		c.lastTick = t;
+		c.blocks++;
+	}
+	if (count && c.trace) {
+		u32 rec[2] = { addr, words | (c.inPhase ? 0x10000u : 0u) };
+		fwrite(rec, sizeof(rec), 1, c.trace);
+		if (--c.traceLeft == 0) {
+			fclose(c.trace);
+			c.trace = nullptr;
+			void ICacheSimDump();
+			ICacheSimDump();
+			fflush(stdout);
+			_exit(0);
+		}
+	}
+	u32 first = (addr & 0x3FFFFFFF) >> 6;
+	u32 last = ((addr & 0x3FFFFFFF) + (words ? words * 4 - 1 : 0)) >> 6;
+	for (u32 line = first; line <= last; line++) {
+		u32 set = line & 127;
+		u32 tag = line;
+		int way;
+		bool hit = true;
+		if (c.tags[set][0] == tag) way = 0;
+		else if (c.tags[set][1] == tag) way = 1;
+		else {
+			hit = false;
+			way = c.lru[set];
+			c.tags[set][way] = tag;
+		}
+		c.lru[set] = (u8)(way ^ 1);
+		if (count) {
+			c.fetches++;
+			c.fetchHist[line << 6]++;
+			if (c.inPhase)
+				c.phaseFetches++;
+			if (!hit) {
+				c.misses++;
+				c.missHist[line << 6]++;
+				if (c.inPhase) {
+					c.phaseMisses++;
+					c.phaseMissHist[line << 6]++;
+				}
+			}
+		}
+	}
+}
+
+inline void ICacheSimDump() {
+	const char *path = getenv("PPSSPP_ICACHE");
+	if (!path || g_icache.enabled != 1)
+		return;
+	FILE *f = fopen(path, "w");
+	if (!f)
+		return;
+	fprintf(f, "# ticks %llu misses %llu fetches %llu blocks %llu frames %llu phase_misses %llu phase_fetches %llu\n",
+		(unsigned long long)(g_icache.lastTick - g_icache.firstTick), (unsigned long long)g_icache.misses,
+		(unsigned long long)g_icache.fetches, (unsigned long long)g_icache.blocks, (unsigned long long)g_icache.frames,
+		(unsigned long long)g_icache.phaseMisses, (unsigned long long)g_icache.phaseFetches);
+	for (auto &kv : g_icache.fetchHist) {
+		auto m = g_icache.missHist.find(kv.first);
+		auto pm = g_icache.phaseMissHist.find(kv.first);
+		fprintf(f, "%08x %llu %llu %llu\n", kv.first, (unsigned long long)(m == g_icache.missHist.end() ? 0 : m->second),
+			(unsigned long long)kv.second, (unsigned long long)(pm == g_icache.phaseMissHist.end() ? 0 : pm->second));
+	}
+	fclose(f);
+}
