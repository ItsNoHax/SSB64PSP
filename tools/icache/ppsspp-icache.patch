 // NOTE: The loader has already been fully resolved (ResolveFileLoaderTarget) and identified here.
+// ---- SSB64PSP guest sampling profiler (env PPSSPP_GUEST_PROFILE=path) ----
+#include <cstdio>
+#include <cstdlib>
+#include <unordered_map>
+#include "Core/MIPS/MIPS.h"
+static int g_guestProfEvent = -1;
+static std::unordered_map<uint64_t, uint32_t> g_guestProfHist;
+static int g_guestProfInterval = 2000;
+static void GuestProfSample(u64 userdata, int cyclesLate) {
+	uint64_t key = ((uint64_t)currentMIPS->r[31] << 32) | currentMIPS->pc;
+	g_guestProfHist[key]++;
+	CoreTiming::ScheduleEvent(g_guestProfInterval, g_guestProfEvent, 0);
+}
+static void GuestProfInit() {
+	if (!getenv("PPSSPP_GUEST_PROFILE")) return;
+	if (getenv("PPSSPP_GUEST_PROFILE_INTERVAL")) g_guestProfInterval = atoi(getenv("PPSSPP_GUEST_PROFILE_INTERVAL"));
+	g_guestProfHist.clear();
+	g_guestProfEvent = CoreTiming::RegisterEvent("GuestProf", GuestProfSample);
+	CoreTiming::ScheduleEvent(g_guestProfInterval, g_guestProfEvent, 0);
+}
+void GuestProfDump() {
+	const char *path = getenv("PPSSPP_GUEST_PROFILE");
+	if (!path || g_guestProfHist.empty()) return;
+	FILE *f = fopen(path, "w");
+	if (!f) return;
+	for (auto &kv : g_guestProfHist)
+		fprintf(f, "%08x %08x %u\n", (uint32_t)kv.first, (uint32_t)(kv.first >> 32), kv.second);
+	fclose(f);
+	g_guestProfHist.clear();
+}
+// ---- end profiler ----
+
